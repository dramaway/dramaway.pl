{
  "name": "dramaway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm --filter web --filter studio --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:studio": "pnpm --filter studio build",
    "lint": "pnpm --filter web lint",
    "deps:outdated": "pnpm outdated -r",
    "deps:update": "pnpm update -r",
    "extract:fundacja": "python3 scripts/extract_fundacja.py",
    "extract:czytelnia": "python3 scripts/extract_czytelnia.py",
    "migrate:fundacja": "node --env-file=apps/studio/.env scripts/migrate-fundacja.mjs",
    "migrate:czytelnia": "node --env-file=apps/studio/.env scripts/migrate-czytelnia.mjs",
    "migrate:art-generacje": "node --env-file=apps/studio/.env scripts/migrate-art-generacje.mjs",
    "patch:publication-format": "node --env-file=apps/studio/.env scripts/patch-publication-format.mjs",
    "patch:publication-listed": "node --env-file=apps/studio/.env scripts/patch-publication-listed.mjs",
    "patch:archive-projects": "node --env-file=apps/studio/.env scripts/patch-archive-projects.mjs",
    "patch:about-copy": "node --env-file=apps/studio/.env scripts/patch-about-copy.mjs",
    "patch:page-section": "node --env-file=apps/studio/.env scripts/patch-page-section.mjs",
    "migrate:news": "node --env-file=apps/studio/.env scripts/migrate-news.mjs",
    "patch:knowledge-page": "node --env-file=apps/studio/.env scripts/patch-knowledge-page.mjs",
    "patch:hero-images": "node --env-file-if-exists=apps/studio/.env scripts/patch-hero-images.mjs",
    "patch:footer-newsletter": "node --env-file-if-exists=apps/studio/.env scripts/patch-footer-newsletter.mjs",
    "seed:footer-links": "node --env-file-if-exists=apps/studio/.env scripts/seed-footer-links.mjs",
    "patch:project-credits": "node --env-file-if-exists=apps/studio/.env scripts/patch-project-credits.mjs",
    "repair:credit-keys": "node --env-file-if-exists=apps/studio/.env scripts/repair-credit-keys.mjs",
    "seed:about-page": "node --env-file=apps/studio/.env scripts/seed-about-page.mjs",
    "seed:landing-pages": "node --env-file=apps/studio/.env scripts/seed-landing-pages.mjs",
    "seed:navigation": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=apps/studio/.env scripts/seed-navigation.mjs",
    "seed:homepage-sections": "node --env-file=apps/studio/.env scripts/seed-homepage-sections.mjs",
    "repair:portable-text": "node --env-file=apps/studio/.env scripts/repair-portable-text.mjs",
    "test:repair": "node --test scripts/lib/portable-text-repair.test.mjs",
    "test:archive-projects": "node --test scripts/lib/archive-project-reshape.test.mjs",
    "test:credits": "node --test scripts/lib/credits-parse.test.mjs",
    "test:web": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts-extension.mjs --test scripts/lib/credits-parse.test.mjs scripts/lib/cms-url-safety.test.mjs scripts/lib/roster-line.test.mjs scripts/lib/navigation.test.mjs scripts/lib/nav-overflow.test.mjs scripts/lib/desk-nav.test.mjs scripts/lib/content-sections.test.mjs scripts/lib/hotspot.test.mjs scripts/lib/page-path.test.mjs scripts/lib/knowledge-page.test.mjs scripts/lib/page-desk.test.mjs scripts/lib/news-cta.test.mjs scripts/lib/news-migrate.test.mjs scripts/lib/cta-button.test.mjs scripts/lib/czytelnia-filters.test.mjs scripts/lib/portable-read-more.test.mjs scripts/lib/hero-slides.test.mjs scripts/lib/history-timeline.test.mjs scripts/lib/newsletter.test.mjs scripts/lib/body-frame.test.mjs"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11.9"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@portabletext/block-tools": "^6.0.3",
    "@sanity/client": "catalog:",
    "@sanity/schema": "catalog:",
    "jsdom": "^30.1.2"
  }
}
