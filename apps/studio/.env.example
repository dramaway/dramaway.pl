# Copy to .env and fill after creating a Sanity project at https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Write token for `pnpm migrate:fundacja` and Studio mutations. Keep this file gitignored.
# Do not copy this into apps/web or any NEXT_PUBLIC_* variable.
SANITY_API_WRITE_TOKEN=

# Public Umami share link for the Studio "Statystyki" tool.
# Leave empty to hide the tool. Paste the link only in this gitignored .env
# (and in the GitHub Actions secret of the same name for hosted Studio).
# Never commit the link.
SANITY_STUDIO_UMAMI_SHARE_URL=
