# Public Sanity values (same project as Studio — do not invent a new one)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional; defaults to 2025-01-01 (matches the migration client)
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Dataset `production` is currently public (CDN reads, no token).
# If the dataset is later made private, add a Viewer/read token here — server only.
# Never put SANITY_API_WRITE_TOKEN (Studio / migrate) in this file or in NEXT_PUBLIC_*.
# SANITY_API_READ_TOKEN=

# Public origin (canonical / Open Graph / sitemap). Preview default is netlify.app.
# NEXT_PUBLIC_SITE_URL=https://dramaway.netlify.app
# At domain cutover:
# NEXT_PUBLIC_SITE_URL=https://fundacja.dramaway.pl
# NEXT_PUBLIC_SITE_INDEX=true
# Leave INDEX unset (or anything other than "true") to keep noindex.

# Server only. Same value as the Sanity webhook (Authorization: Bearer …).
# Not a write token — it only lets Sanity ask Netlify to refresh HTML.
# SANITY_REVALIDATE_SECRET=

# Server only. Footer signup does not call MailerLite until both are set
# and the HTTP client is added. Never prefix these with NEXT_PUBLIC_.
# MAILERLITE_API_KEY=
# MAILERLITE_GROUP_ID=

# Umami Cloud (no cookies). Leave both empty until visits should be counted.
# Without NEXT_PUBLIC_UMAMI_WEBSITE_ID the script is not loaded
# (local, Deploy Preview, and until that decision).
# Empty SCRIPT_URL uses https://cloud.umami.is/script.js.
# Set the host from the Umami panel when the EU region uses a different one.
# That same host is added to CSP script-src and connect-src.
# The tag only counts fundacja.dramaway.pl, not netlify.app or localhost.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Pre-launch cover. Set both in Netlify Production, never commit a value.
# COVER_MODE=on closes the site even when COVER_SECRET is missing or mistyped.
# Preview (?podglad=) works only when the secret matches. Do not reuse it after launch.
# COVER_MODE=
# COVER_SECRET=

